# ---- 缓存与虚拟环境 ----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 本地库文件（导入 / 试跑用，不属于交付内容）----
web/data/library.local.json
data/library.local.json

# ---- 本地跑批结果 ----
# 占位产物一律不入库：它们没有调用任何专家，数字不可引用。
# 命名实际是「<日期>-local.json」（连字符），而旧规则写的是 *.local.json（点），
# 两者永远匹配不上 —— 占位结果因此被提交过。两种写法都写上。
reports/**/*-local.json
reports/**/*.local.json
reports/**/*-placeholder-*.json
reports/**/eval-log.local.md

# ---- 本地临时输出（命令无法回传 stdout 时落的盘，随时可丢）----
reports/_tmp/

# ---- 例外：归档目录里的占位产物要进仓库 ----
# 它们是「占位数据没有被当成评测结果」这条纪律被执行的证据，不是成绩。
!reports/archive/placeholder/**

# 工具产物与占位结果（2026-09-23 交付卫生）
.workbuddy/
reports/eval-results/*-local.json
